# ==========================================
# HireFlow AI — Environment Configuration
# ==========================================

# Google Gemini API Key (Optional — fallback mock engine active if omitted)
GEMINI_API_KEY=

# OpenAI API Key (Optional — fallback mock engine active if omitted)
OPENAI_API_KEY=

# Default LLM Provider ("gemini" or "openai")
DEFAULT_LLM_PROVIDER=gemini

# Database URL (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///./hireflow.db

# Storage Paths
UPLOAD_DIR=./uploads
SAMPLE_DATA_DIR=./data/sample_resumes

# Demo Mode Enabled (Guarantees 100% offline hackathon presentation resilience)
DEMO_MODE=true
